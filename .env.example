# -------------------------------------------------------------
# PaintMyWall Environment Configuration
# -------------------------------------------------------------

# LLM Provider Configuration: 'gemini' | 'anthropic' | 'groq'
LLM_PROVIDER=gemini

# Google Gemini (Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-90b-vision-preview

# Exterior Scheme Image-Editing Model Configuration
# Model options: 'gemini-2.5-flash-image' | 'imagen-3.0-generate-002' | 'gemini-3.1-flash-image' | 'mock'
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_API_KEY=your_image_api_key_here
IMAGE_ALLOW_MOCK=false
IMAGE_GLOBAL_DAILY_CAP=100
IMAGE_PER_IP_DAILY_LIMIT=10

# Database Configuration
# Local SQLite default: sqlite:///./paintmywall.db
# PostgreSQL (Docker): postgresql+psycopg2://paintuser:paintpass@localhost:5432/paintmywall
DATABASE_URL=sqlite:///./paintmywall.db

# Admin Security
ADMIN_PASSWORD=paintshop_admin_secret_2026

# WhatsApp contact for customer inquiries
SHOP_WHATSAPP_NUMBER=+919876543210

# Rate Limiting (requests per minute per IP for uploads)
RATE_LIMIT_PER_MINUTE=5

# CORS Allowed Origins (comma-separated origins, or * for all)
# Example: http://localhost:3000
CORS_ORIGINS=*

# ONNX Segmentation Model Variant: 'b2' (default high accuracy) | 'b0' (low memory <512MB RAM)
SEGFORMER_MODEL_VARIANT=b2

# Segmentation Model Cache Directory
MODEL_DIR=./backend/models
UPLOAD_DIR=./backend/uploads

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=+919876543210
